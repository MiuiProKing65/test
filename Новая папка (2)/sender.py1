from telethon import TelegramClient
from telethon.tl.functions.account import UpdateProfileRequest
import asyncio
from datetime import datetime
import requests
from bs4 import BeautifulSoup
from playsound import playsound

# --- Данные приложения ---
api_id = 25889533
api_hash = "ea4dbf39e42c3a04639a7cdb281d6fe7"
phone = "+380959069373"
client = TelegramClient("my_session", api_id, api_hash)

def write_log(text):
    with open("log.txt", "a", encoding="utf-8") as f:
        f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {text}\n")

# Получение погоды с Google
def get_weather_google():
    try:
        url = "https://www.google.com/search?q=Погода+Павлоград"
        headers = {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                          "(KHTML, like Gecko) Chrome/116.0.0.0 Safari/537.36"
        }
        response = requests.get(url, headers=headers)
        soup = BeautifulSoup(response.text, "html.parser")
        temp = soup.find("span", {"id": "wob_tm"}).text
        desc = soup.find("span", {"id": "wob_dc"}).text
        feels_like = soup.find("span", {"id": "wob_ttm"}).text
        humidity = soup.find("span", {"id": "wob_hm"}).text
        wind = soup.find("span", {"id": "wob_ws"}).text

        about = f"🌦 {temp}°C, {desc} | Ощущается: {feels_like}°C | 💧{humidity} | 🌬{wind}"
        return about
    except Exception as e:
        # Резервные данные о погоде
        write_log(f"⚠ Ошибка получения погоды: {e}")
        return "🌦 22°C, Переменная облачность | Ощущается: 21°C | 💧60% | 🌬3 м/с"

# Проверка воздушной тревоги (заглушка, так как API не работает)
def check_air_alert():
    try:
        # Здесь должен быть новый API или источник данных о тревогах
        # Пока используем заглушку
        write_log("⚠ API alerts.in.ua недоступен, тревога не проверяется")
        return False
    except Exception as e:
        write_log(f"⚠ Ошибка проверки тревоги: {e}")
        return False

async def main():
    await client.start(phone=phone)
    me = await client.get_me()
    username = f"@{me.username}" if me.username else me.phone
    write_log(f"✅ Вошёл как {username}")

    last_weather_update = datetime.now()
    weather = get_weather_google()
    previous_alert_state = False

    while True:
        now = datetime.now()
        now_time = now.strftime("%H:%M:%S")
        today = now.strftime("%d.%m")

        # Обновление погоды каждые 30 минут
        if (now - last_weather_update).seconds >= 1800:
            weather = get_weather_google()
            last_weather_update = now
            write_log(f"🌦 Погода обновлена: {weather}")

        is_alert = check_air_alert()

        # Формирование фамилии: дата + время + тревога
        lastname = f"⏰ {today} | {now_time}"
        if is_alert:
            lastname += " | ⚠️ Тревога!"

        # Обновление профиля
        try:
            await client(UpdateProfileRequest(
                last_name=lastname,
                about=weather
            ))
            write_log(f"🔄 Профиль обновлён: {lastname} | {weather}")
        except Exception as e:
            write_log(f"⚠ Ошибка обновления профиля: {e}")

        # Сообщение в «Избранное»
        msg = f"{lastname}\n{weather}"
        if is_alert:
            msg += "\n🚨 В Павлограде воздушная тревога! Находитесь в укрытии!"
            if not previous_alert_state:
                try:
                    await client.send_message("me", f"🔔 {msg}")
                    playsound("alarm.mp3")
                    write_log("🔊 Push-уведомление и звук!")
                except Exception as e:
                    write_log(f"⚠ Ошибка уведомления: {e}")
        else:
            await client.send_message("me", msg)
            write_log(f"📩 Сообщение: {msg}")

        previous_alert_state = is_alert
        await asyncio.sleep(60)

with client:
    client.loop.run_until_complete(main())